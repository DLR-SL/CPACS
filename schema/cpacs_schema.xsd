                    <ddue:summary>
                        <ddue:para>Generic floor modules</ddue:para>
                    </ddue:summary>
                    <ddue:remarks>
                        <ddue:para>Generic floor module instance collection type.</ddue:para>
                    </ddue:remarks>
                </sd:schemaDoc>
            </xsd:appinfo>
        </xsd:annotation>
        <xsd:complexContent>
            <xsd:extension base="complexBaseType">
