                        <xsd:annotation>
                            <xsd:documentation>Topology entries connecting the dynamic models of the components</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:all>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>

    <xsd:complexType name="electricPowerTrajectoryType">
        <xsd:annotation>
