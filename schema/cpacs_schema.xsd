    <xsd:complexType name="approximationSettingsType">
        <xsd:annotation>
            <xsd:appinfo>
                <sd:schemaDoc>
                    <ddue:summary>
                        <ddue:para>Settings for approximating a point list</ddue:para>
                    </ddue:summary>
                    <ddue:remarks>
                        <ddue:content>
                            <ddue:para>
                                The curve is fitted to the points either with a given number of control points or within a given maximum error.
                                The error is measured as the distance between each point and the curve, in the coordinates of the point list.
                            </ddue:para>
                        </ddue:content>
                    </ddue:remarks>
                </sd:schemaDoc>
            </xsd:appinfo>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:choice>
                <xsd:element name="controlPointNumber" default="12">
                    <xsd:annotation>
                        <xsd:documentation>Number of control points of the approximating B-spline curve (at least 4)</xsd:documentation>
                    </xsd:annotation>
                    <xsd:complexType>
                        <xsd:simpleContent>
                            <xsd:restriction base="integerBaseType">
                                <xsd:minInclusive value="4"/>
                            </xsd:restriction>
                        </xsd:simpleContent>
                    </xsd:complexType>
                </xsd:element>
                <xsd:element name="maximumError" default="1e-5">
                    <xsd:annotation>
                        <xsd:documentation>Maximum approximation error; the number of control points is increased until the error is below this value</xsd:documentation>
                    </xsd:annotation>
                    <xsd:complexType>
                        <xsd:simpleContent>
                            <xsd:restriction base="doubleBaseType">
                                <xsd:minExclusive value="0"/>
                            </xsd:restriction>
                        </xsd:simpleContent>
                    </xsd:complexType>
                </xsd:element>
            </xsd:choice>
            <xsd:element name="interpolatedPointsIndices" minOccurs="0" type="stringVectorBaseType">
                <xsd:annotation>
                    <xsd:documentation>Indices of the points that are interpolated nonetheless, each in the range from 1 to the number of points</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
        <xsd:attribute name="errorComputationMethod" default="RMSE">
            <xsd:annotation>
                <xsd:documentation>Method for combining the distances between the points and the curve into the approximation error: RMSE (root mean square, default) or MaxError (maximum)</xsd:documentation>
            </xsd:annotation>
            <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                </xsd:restriction>
            </xsd:simpleType>
        </xsd:attribute>
    </xsd:complexType>

