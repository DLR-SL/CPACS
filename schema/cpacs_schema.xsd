                                <ddue:content>
                                    <ddue:para>Not yet released</ddue:para>
                                    <ddue:list class="bullet">
                                        <ddue:listItem>
                                            Revised documentation, template and examples for tool-specific data (<ddue:codeInline>toolspecific</ddue:codeInline>)
                                        </ddue:listItem>
