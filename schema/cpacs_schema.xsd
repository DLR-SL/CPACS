                            <xsd:element name="structuralElementHorizontalUID" minOccurs="0" type="stringUIDBaseType">
                                <xsd:annotation>
                                    <xsd:documentation>UID of structural elements used as
                                        horizontal reinforcements</xsd:documentation>
                                </xsd:annotation>
                            </xsd:element>
                        </xsd:sequence>
                        <xsd:sequence>
