                            box with the forward wing attachment.</ddue:para>
                    </ddue:summary>
                </sd:schemaDoc>
            </xsd:appinfo>
        </xsd:annotation>
        <xsd:complexContent>
            <xsd:extension base="complexBaseType">
                <xsd:sequence>
                    <xsd:element name="upperLink" maxOccurs="unbounded" type="strutType">
                        <xsd:annotation>
