                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="genericFloorModules" minOccurs="0" type="genericFloorModulesType">
                        <xsd:annotation>
                            <xsd:documentation>Generic floor modules</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="lavatories" minOccurs="0" type="lavatoriesType">
                        <xsd:annotation>
