    <xsd:complexType name="cockpitControlType">
        <xsd:annotation>
            <xsd:appinfo>
                <sd:schemaDoc>
                    <ddue:summary>
                        <ddue:para>Cockpit control</ddue:para>
                    </ddue:summary>
                    <ddue:remarks>
