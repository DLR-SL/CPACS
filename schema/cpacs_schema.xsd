                            <xsd:documentation>Flag for automatic generation of interface
                                definitions (draft version)</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="rivetJointAreas" minOccurs="0" type="rivetJointAreasAssemblyType">
