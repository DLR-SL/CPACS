<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
        xmlns:ddue="http://ddue.schemas.microsoft.com/authoring/2003/5"
        xmlns:html="http://www.w3.org/1999/xhtml"
        xmlns:sd="http://schemas.xsddoc.codeplex.com/schemaDoc/2009/3"
        xmlns:xlink="http://www.w3.org/1999/xlink"
        targetNamespace="http://www.cpacs.de/myTool"
        xmlns="http://www.cpacs.de/myTool"
        elementFormDefault="qualified">

    <!-- This schema is a template that can be used as a starting point for your own
         tool schema, i.e. the schema of the data a tool stores below
         cpacs/toolspecific/tool. The rules for tool data are documented in the
         toolspecificType of the CPACS schema. To adapt the template:

         1. Replace the namespace URI "http://www.cpacs.de/myTool" in both
            targetNamespace and xmlns above. The URI is only a name for your tool
            schema: it looks like a web address, but nothing is ever downloaded from
            it; it only has to be unique. Unless you prefer a URI of your own, use
            "http://www.cpacs.de/" followed by the name of your tool.
         2. Rename the global element "myToolName" and its type "myToolType", and
            replace the example content of the type with your own elements.
         3. Keep the schemaVersion attribute and increase its value whenever the
            structure of your tool data changes.

         The base types below are copies of the corresponding CPACS base types,
         reduced to the external data attributes. Copy further CPACS base types into
         this file as needed. Document elements and types following the development
         guidelines of CPACS (development/developmentGuidelines.md). -->

    <!-- Global element: the root element of the tool data below cpacs/toolspecific/tool -->
    <xsd:element name="myToolName" type="myToolType"/>

    <!-- Base types -->
    <xsd:complexType name="complexBaseType">
        <xsd:annotation>
            <xsd:appinfo>
                <sd:schemaDoc>
                    <ddue:summary>
                        <ddue:para>Complex base type</ddue:para>
                    </ddue:summary>
                    <ddue:remarks>
                        <ddue:para>Base type for complex nodes (including external data
                            attributes)</ddue:para>
                    </ddue:remarks>
                </sd:schemaDoc>
            </xsd:appinfo>
        </xsd:annotation>
        <xsd:attribute name="externalDataNodePath" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>Path of the node inside the external data file</xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
        <xsd:attribute name="externalFileName" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>Name of the external data file</xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
        <xsd:attribute name="externalDataDirectory" type="xsd:string">
            <xsd:annotation>
                <xsd:documentation>Directory of the external data file</xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
    </xsd:complexType>

    <xsd:complexType name="stringBaseType">
        <xsd:annotation>
            <xsd:appinfo>
                <sd:schemaDoc>
                    <ddue:summary>
                        <ddue:para>String base type</ddue:para>
                    </ddue:summary>
                    <ddue:remarks>
                        <ddue:para>Base type for string nodes (including external data
                            attributes)</ddue:para>
                    </ddue:remarks>
                </sd:schemaDoc>
            </xsd:appinfo>
        </xsd:annotation>
        <xsd:simpleContent>
            <xsd:extension base="xsd:string">
                <xsd:attribute name="externalDataNodePath" type="xsd:string">
                    <xsd:annotation>
                        <xsd:documentation>Path of the node inside the external data file</xsd:documentation>
                    </xsd:annotation>
                </xsd:attribute>
                <xsd:attribute name="externalFileName" type="xsd:string">
                    <xsd:annotation>
                        <xsd:documentation>Name of the external data file</xsd:documentation>
                    </xsd:annotation>
                </xsd:attribute>
                <xsd:attribute name="externalDataDirectory" type="xsd:string">
                    <xsd:annotation>
                        <xsd:documentation>Directory of the external data file</xsd:documentation>
                    </xsd:annotation>
                </xsd:attribute>
            </xsd:extension>
        </xsd:simpleContent>
    </xsd:complexType>

    <xsd:complexType name="doubleBaseType">
        <xsd:annotation>
            <xsd:appinfo>
                <sd:schemaDoc>
                    <ddue:summary>
                        <ddue:para>Floating point base type</ddue:para>
                    </ddue:summary>
                    <ddue:remarks>
                        <ddue:para>Base type for double nodes (including external data
                            attributes). Unlike the CPACS base type, this copy carries no
                            uncertainty attributes.</ddue:para>
                    </ddue:remarks>
                </sd:schemaDoc>
            </xsd:appinfo>
        </xsd:annotation>
        <xsd:simpleContent>
            <xsd:extension base="xsd:double">
                <xsd:attribute name="externalDataNodePath" type="xsd:string">
                    <xsd:annotation>
                        <xsd:documentation>Path of the node inside the external data file</xsd:documentation>
                    </xsd:annotation>
                </xsd:attribute>
                <xsd:attribute name="externalFileName" type="xsd:string">
                    <xsd:annotation>
                        <xsd:documentation>Name of the external data file</xsd:documentation>
                    </xsd:annotation>
                </xsd:attribute>
                <xsd:attribute name="externalDataDirectory" type="xsd:string">
                    <xsd:annotation>
                        <xsd:documentation>Directory of the external data file</xsd:documentation>
                    </xsd:annotation>
                </xsd:attribute>
            </xsd:extension>
        </xsd:simpleContent>
    </xsd:complexType>

    <!-- Type of the global element: replace its documentation and content with your own -->
    <xsd:complexType name="myToolType">
        <xsd:annotation>
            <xsd:appinfo>
                <sd:schemaDoc>
                    <ddue:summary>
                        <ddue:para>Data of my example tool</ddue:para>
                    </ddue:summary>
                    <ddue:remarks>
                        <ddue:content>
                            <ddue:section>
                                <ddue:title>1. Overview</ddue:title>
                                <ddue:content>
                                    <ddue:para>
                                        Replace this text: describe what the tool stores here, which
                                        CPACS data it refers to (by UID), and how the data is meant to be
                                        read and written.
                                    </ddue:para>
                                </ddue:content>
                            </ddue:section>
                        </ddue:content>
                    </ddue:remarks>
                </sd:schemaDoc>
            </xsd:appinfo>
        </xsd:annotation>
        <xsd:complexContent>
            <xsd:extension base="complexBaseType">
                <xsd:all>
                    <xsd:element name="parentElement" type="parentElementType">
                        <xsd:annotation>
                            <xsd:documentation>Parent element</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:all>
                <!-- A schemaVersion attribute documents the version of the tool schema and
                     lets readers detect which structure they are processing. List every
                     supported version as an enumeration value. -->
                <xsd:attribute name="schemaVersion">
                    <xsd:annotation>
                        <xsd:documentation>Version of the tool schema the data conforms to</xsd:documentation>
                    </xsd:annotation>
                    <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                            <xsd:enumeration value="1.0"/>
                        </xsd:restriction>
                    </xsd:simpleType>
                </xsd:attribute>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>

    <xsd:complexType name="parentElementType">
        <xsd:annotation>
            <xsd:appinfo>
                <sd:schemaDoc>
                    <ddue:summary>
                        <ddue:para>Element with child elements</ddue:para>
                    </ddue:summary>
                </sd:schemaDoc>
            </xsd:appinfo>
        </xsd:annotation>
        <xsd:complexContent>
            <xsd:extension base="complexBaseType">
                <xsd:all>
                    <xsd:element name="childElement1" type="stringBaseType">
                        <xsd:annotation>
                            <xsd:documentation>First child element, a string</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="childElement2" type="doubleBaseType">
                        <xsd:annotation>
                            <xsd:documentation>Second child element, a floating point value</xsd:documentation>
                        </xsd:annotation>
                    </xsd:element>
                </xsd:all>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>

</xsd:schema>
