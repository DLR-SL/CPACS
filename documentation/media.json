    "eq_cst2D_shapeFunction": {
      "file": "equations/cst2D_shapeFunction.png",
      "alt": "S(\\psi) = \\sum_{i=0}^{n} B_i \\frac{n!}{i!(n-i)!} \\psi^i (1-\\psi)^{n-i}"
    },
    "eq_cst2D_surfaces": {
      "file": "equations/cst2D_surfaces.png",
