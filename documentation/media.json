    },
    "eq_guideCurvePoint": {
      "file": "equations/guideCurvePoint.png",
      "alt": "P = P0 + rY (P1 - P0) + s (rX ex + rZ ez), s = (1 - rY) s0 + rY s1, ez = ex x (P1 - P0) / |ex x (P1 - P0)|"
    },
    "eq_nacaProfile4Digit": {
