<?xml version="1.0" encoding="UTF-8"?>
<cpacs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../schema/cpacs_schema.xsd">
    <header>
        <name>Fuselage standard profiles</name>
        <description>Fuselage profiles defined by rectangles and superellipses, and a fuselage using some of them. Generated by documentation/scripts/standardProfile.py.</description>
        <version>1.0.0</version>
        <versionInfos>
            <versionInfo version="1.0.0">
                <creator>DLR-SL</creator>
                <timestamp>2026-09-15T12:00:00</timestamp>
                <description>Initial data set</description>
                <cpacsVersion>3.5</cpacsVersion>
            </versionInfo>
        </versionInfos>
    </header>
    <vehicles>
        <aircraft>
            <model uID="StandardProfileAircraft">
                <name>Standard profile example</name>
                <fuselages>
                    <fuselage uID="StandardFuselage">
                        <name>Fuselage with standard profiles</name>
                        <description>Circle (diameter 1 m), superellipse (2 m wide and high) and rectangle with rounded corners (1.6 m wide, 1.2 m high). Top, sides and bottom of the profiles are connected along the fuselage.</description>
                        <transformation>
                            <rotation>
                                <x>0</x>
                                <y>0</y>
                                <z>0</z>
                            </rotation>
                            <scaling>
                                <x>1</x>
                                <y>1</y>
                                <z>1</z>
                            </scaling>
                            <translation>
                                <x>0</x>
                                <y>0</y>
                                <z>0</z>
                            </translation>
                        </transformation>
                        <sections>
                            <section uID="StandardFuselage_front">
                                <name>Front section</name>
                                <transformation>
                                    <rotation>
                                        <x>0</x>
                                        <y>0</y>
                                        <z>0</z>
                                    </rotation>
                                    <scaling>
                                        <x>1</x>
                                        <y>1</y>
                                        <z>1</z>
                                    </scaling>
                                    <translation>
                                        <x>0</x>
                                        <y>0</y>
                                        <z>0</z>
                                    </translation>
                                </transformation>
                                <elements>
                                    <element uID="StandardFuselage_front_element">
                                        <name>Front section element</name>
                                        <profileUID>CircleProfile</profileUID>
                                        <transformation>
                                            <rotation>
                                                <x>0</x>
                                                <y>0</y>
                                                <z>0</z>
                                            </rotation>
                                            <scaling>
                                                <x>1</x>
                                                <y>1</y>
                                                <z>1</z>
                                            </scaling>
                                            <translation>
                                                <x>0</x>
                                                <y>0</y>
                                                <z>0</z>
                                            </translation>
                                        </transformation>
                                    </element>
                                </elements>
                            </section>
                            <section uID="StandardFuselage_middle">
                                <name>Middle section</name>
                                <transformation>
                                    <rotation>
                                        <x>0</x>
                                        <y>0</y>
                                        <z>0</z>
                                    </rotation>
                                    <scaling>
                                        <x>1</x>
                                        <y>1</y>
                                        <z>1</z>
                                    </scaling>
                                    <translation>
                                        <x>3</x>
                                        <y>0</y>
                                        <z>0</z>
                                    </translation>
                                </transformation>
                                <elements>
                                    <element uID="StandardFuselage_middle_element">
                                        <name>Middle section element</name>
                                        <profileUID>SuperEllipseProfile</profileUID>
                                        <transformation>
                                            <rotation>
                                                <x>0</x>
                                                <y>0</y>
                                                <z>0</z>
                                            </rotation>
                                            <scaling>
                                                <x>1</x>
                                                <y>2</y>
                                                <z>2</z>
                                            </scaling>
                                            <translation>
                                                <x>0</x>
                                                <y>0</y>
                                                <z>0</z>
                                            </translation>
                                        </transformation>
                                    </element>
                                </elements>
                            </section>
                            <section uID="StandardFuselage_rear">
                                <name>Rear section</name>
                                <transformation>
                                    <rotation>
                                        <x>0</x>
                                        <y>0</y>
                                        <z>0</z>
                                    </rotation>
                                    <scaling>
                                        <x>1</x>
                                        <y>1</y>
                                        <z>1</z>
                                    </scaling>
                                    <translation>
                                        <x>7</x>
                                        <y>0</y>
                                        <z>0</z>
                                    </translation>
                                </transformation>
                                <elements>
                                    <element uID="StandardFuselage_rear_element">
                                        <name>Rear section element</name>
                                        <profileUID>RectangleProfile</profileUID>
                                        <transformation>
                                            <rotation>
                                                <x>0</x>
                                                <y>0</y>
                                                <z>0</z>
                                            </rotation>
                                            <scaling>
                                                <x>1</x>
                                                <y>1.6</y>
                                                <z>1.6</z>
                                            </scaling>
                                            <translation>
                                                <x>0</x>
                                                <y>0</y>
                                                <z>0</z>
                                            </translation>
                                        </transformation>
                                    </element>
                                </elements>
                            </section>
                        </sections>
                        <segments>
                            <segment uID="StandardFuselage_front_segment">
                                <name>Segment</name>
                                <fromElementUID>StandardFuselage_front_element</fromElementUID>
                                <toElementUID>StandardFuselage_middle_element</toElementUID>
                            </segment>
                            <segment uID="StandardFuselage_middle_segment">
                                <name>Segment</name>
                                <fromElementUID>StandardFuselage_middle_element</fromElementUID>
                                <toElementUID>StandardFuselage_rear_element</toElementUID>
                            </segment>
                        </segments>
                    </fuselage>
                </fuselages>
            </model>
        </aircraft>
        <profiles>
            <fuselageProfiles>
                <fuselageProfile uID="RectangleProfile">
                    <name>Rectangle with rounded corners</name>
                    <standardProfile>
                        <rectangle>
                            <cornerRadius>0.15</cornerRadius>
                            <heightToWidthRatio>0.75</heightToWidthRatio>
                        </rectangle>
                    </standardProfile>
                </fuselageProfile>
                <fuselageProfile uID="SuperEllipseProfile">
                    <name>Superellipse with flattened lower half</name>
                    <standardProfile>
                        <superEllipse>
                            <mUpper>2</mUpper>
                            <nUpper>2</nUpper>
                            <mLower>3</mLower>
                            <nLower>2</nLower>
                            <lowerHeightFraction>0.4</lowerHeightFraction>
                        </superEllipse>
                    </standardProfile>
                </fuselageProfile>
                <fuselageProfile uID="RectangleProfile_example">
                    <name>Rectangle, corner radius 0.125</name>
                    <standardProfile>
                        <rectangle>
                            <cornerRadius>0.125</cornerRadius>
                            <heightToWidthRatio>0.5</heightToWidthRatio>
                        </rectangle>
                    </standardProfile>
                </fuselageProfile>
                <fuselageProfile uID="RectangleProfile_largestRadius">
                    <name>Rectangle with the largest corner radius</name>
                    <standardProfile>
                        <rectangle>
                            <cornerRadius>0.25</cornerRadius>
                            <heightToWidthRatio>0.5</heightToWidthRatio>
                        </rectangle>
                    </standardProfile>
                </fuselageProfile>
                <fuselageProfile uID="SuperEllipseProfile_example1">
                    <name>Superellipse with pointed top and boxy bottom</name>
                    <standardProfile>
                        <superEllipse>
                            <mUpper>0.5</mUpper>
                            <nUpper>2</nUpper>
                            <mLower>5</mLower>
                            <nLower>3</nLower>
                            <lowerHeightFraction>0.25</lowerHeightFraction>
                        </superEllipse>
                    </standardProfile>
                </fuselageProfile>
                <fuselageProfile uID="CircleProfile">
                    <name>Circle</name>
                    <standardProfile>
                        <superEllipse>
                            <mUpper>2</mUpper>
                            <nUpper>2</nUpper>
                            <mLower>2</mLower>
                            <nLower>2</nLower>
                            <lowerHeightFraction>0.5</lowerHeightFraction>
                        </superEllipse>
                    </standardProfile>
                </fuselageProfile>
                <fuselageProfile uID="DiamondProfile">
                    <name>Diamond</name>
                    <standardProfile>
                        <superEllipse>
                            <mUpper>1</mUpper>
                            <nUpper>1</nUpper>
                            <mLower>1</mLower>
                            <nLower>1</nLower>
                            <lowerHeightFraction>0.5</lowerHeightFraction>
                        </superEllipse>
                    </standardProfile>
                </fuselageProfile>
            </fuselageProfiles>
        </profiles>
    </vehicles>
</cpacs>